# =====================================================================
# .env.example  —  株式会社ラインワークス 公式 X アカウント運用 VPS 環境変数
# =====================================================================
# 使い方:
#   1. cp .env.example .env
#   2. 値を埋める
#   3. chmod 600 .env
#   4. systemd サービス再起動: sudo systemctl restart xops-discord-bot
# このファイルは Git にコミットして OK（実値は入っていない）
# .env そのものは .gitignore で保護済み
# =====================================================================

# --- Discord Bot ---
DISCORD_BOT_TOKEN=
# Discord ユーザー ID をカンマ区切り（空 = 全員許可、推奨は限定）
DISCORD_ALLOWED_USER_IDS=

# --- X (Twitter) API  Phase 3 ---
# 取得方法: docs/X_API_SETUP.md
# 4 つすべて必須。投稿には OAuth 1.0a User Context を使用
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 投稿先アカウントの screen_name（@抜き）。投稿後の URL 構築用
# 例: lineworks_chiba
X_SCREEN_NAME=

# --- OpenAI (Codex フォールバック画像生成用、optional) ---
OPENAI_API_KEY=
